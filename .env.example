# Подключение к LLM через OpenAI-compatible API
# Скопируйте этот файл в .env и подставьте свои значения (.env включён в .gitignore)

# Базовый URL API-роутера или провайдера
#   DeepSeek напрямую:  https://api.deepseek.com/v1
#   OpenRouter:         https://openrouter.ai/api/v1
#   Свой роутер:        https://api.example.com/v1
LLM_BASE_URL=https://api.example.com/v1

# Ключ API
LLM_API_KEY=sk-your-key-here

# Имя модели в том виде, в котором его принимает endpoint:
#   deepseek-chat, claude-haiku-4-5-20251001, deepseek/deepseek-chat, ...
LLM_MODEL=deepseek-chat

# Параметры чанкинга, поиска и генерации задаются в полях датаклассов src/config.py

# Если в системе прописан прокси со схемой, которую не понимает httpx (н-р, socks4:// из реестра Windows),
# раскомментируйте строку ниже - соединения пойдут напрямую:
# NO_PROXY=*
